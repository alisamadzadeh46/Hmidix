# Copy this file to ".env" and adjust the values.

# --- General ---
# Required when DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,hamidix.ir,www.hamidix.ir
CSRF_TRUSTED_ORIGINS=https://hamidix.ir,https://www.hamidix.ir

# --- Database ---
# Local development: leave DB_ENGINE=sqlite (uses db.sqlite3).
# Production (phpMyAdmin / MySQL): set DB_ENGINE=mysql and fill the rest.
DB_ENGINE=sqlite
DB_NAME=hamidix
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Payment gateway ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
SITE_URL=

# --- Store contact details (leave empty to hide an item) ---
STORE_PHONE=
STORE_ADDRESS=
# Social handles without "@" or URL
STORE_TELEGRAM_SUPPORT=
STORE_TELEGRAM_CHANNEL=
STORE_BALE=
STORE_RUBIKA=
STORE_INSTAGRAM=

# --- e-Namad trust seal (leave empty to hide the seal) ---
ENAMAD_ID=
ENAMAD_CODE=

# --- Production security (only used when DEBUG=False) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Deployment (used only by deploy.py) ---
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_KEY_FILE=
DEPLOY_PASSWORD=
DEPLOY_REMOTE_ROOT=/var/www/hamidix
DEPLOY_SERVICE=hamidix
